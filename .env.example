# BI (QEBI) standalone — TODAS las variables llevan prefijo BI_ (así nunca chocan con las de
# qeb-Back). Copia este archivo a .env y llena los secretos. El .env NO se commitea.

# Puerto del proceso (en el droplet: 3200; nginx hace el proxy).
PORT=3200

# CORS: orígenes del front, coma-separado. Ademas, localhost/127.0.0.1 (cualquier puerto) y
# cualquier *.qeb.mx / *.vercel.app ya se permiten solos.
BI_CORS_ORIGIN=https://bi.qeb.mx

# --- BD de ventas (SOLO LECTURA): de aquí sale V_APS_Globales ---
BI_DB_HOST=
BI_DB_PORT=25060
BI_DB_USER=
BI_DB_PASSWORD=
BI_DB_NAME=u658050396_QEB
BI_DB_SSL=true

# Base donde vive/lee la tabla editable bi_presupuesto (default = BI_DB_NAME).
BI_WRITE_DB=
# true = el BI crea bi_presupuesto (única escritura en la BD de ventas). Déjalo en false en prod.
BI_ALLOW_CREATE=false

# --- BD propia ESCRIBIBLE (Hostinger): usuarios (qebi_usuario) + objetivos/metas ---
BI_WDB_HOST=srv1978.hstgr.io
BI_WDB_PORT=3306
BI_WDB_USER=u658050396_QEBI
BI_WDB_PASSWORD=
BI_WDB_NAME=u658050396_QEBI

# 'TOTAL' = todos los Monto Total; 'VENTA' = solo U_dscTAsig='Venta'
BI_VENTA_DEF=TOTAL

# Secreto de los JWT del BI (mínimo 32 caracteres). DISTINTO del JWT_SECRET de qeb-Back.
BI_JWT_SECRET=

# Llave del endpoint temporal POST /usuarios/_seed (vacía = apagado)
BI_SEED_KEY=
